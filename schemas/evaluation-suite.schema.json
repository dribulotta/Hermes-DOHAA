{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dribulotta/Hermes-DOHAA/schemas/evaluation-suite.schema.json",
  "title": "Hermes-DOHAA comparative evaluation suite",
  "type": "object",
  "$defs": {
    "resultSpec": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyResultSpec"
        },
        {
          "$ref": "#/$defs/recursiveResultSpec"
        }
      ]
    },
    "legacyResultSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_keys",
        "additional_keys",
        "types",
        "enums"
      ],
      "properties": {
        "required_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "additional_keys": {
          "type": "boolean"
        },
        "types": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "array",
              "boolean",
              "integer",
              "null",
              "number",
              "object",
              "string"
            ]
          }
        },
        "enums": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "resultSpecNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "array",
            "boolean",
            "integer",
            "null",
            "number",
            "object",
            "string"
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/resultSpecNode"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "additional_properties": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/resultSpecNode"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {},
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "properties"
                  ]
                },
                {
                  "required": [
                    "required"
                  ]
                },
                {
                  "required": [
                    "additional_properties"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "items"
            ]
          },
          "else": {
            "not": {
              "required": [
                "items"
              ]
            }
          }
        }
      ]
    },
    "recursiveResultSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_version",
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "array",
            "boolean",
            "integer",
            "null",
            "number",
            "object",
            "string"
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/resultSpecNode"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "additional_properties": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/resultSpecNode"
        },
        "spec_version": {
          "const": "2.0"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {},
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "properties"
                  ]
                },
                {
                  "required": [
                    "required"
                  ]
                },
                {
                  "required": [
                    "additional_properties"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "items"
            ]
          },
          "else": {
            "not": {
              "required": [
                "items"
              ]
            }
          }
        }
      ]
    },
    "semanticExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "ref",
            "add",
            "subtract",
            "multiply",
            "divide",
            "abs",
            "round",
            "length",
            "sum",
            "min",
            "max",
            "filter",
            "project",
            "sort_by",
            "at",
            "unique",
            "duration_minutes",
            "add_days",
            "add_business_days"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/semanticExpression"
          }
        },
        "source": {
          "enum": [
            "inputs",
            "result"
          ]
        },
        "pointer": {
          "type": "string"
        },
        "comparator": {
          "enum": [
            "equals",
            "not_equals",
            "less_than",
            "less_than_or_equal",
            "greater_than",
            "greater_than_or_equal"
          ]
        },
        "order": {
          "enum": [
            "ascending",
            "descending"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 9999
        },
        "digits": {
          "type": "integer",
          "minimum": -12,
          "maximum": 12
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "ref"
              }
            }
          },
          "then": {
            "required": [
              "source",
              "pointer"
            ]
          },
          "else": {
            "required": [
              "args"
            ]
          }
        }
      ]
    },
    "semanticAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "operator",
        "left",
        "right"
      ],
      "properties": {
        "assertion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "less_than",
            "less_than_or_equal",
            "greater_than",
            "greater_than_or_equal",
            "set_equals"
          ]
        },
        "left": {
          "$ref": "#/$defs/semanticExpression"
        },
        "right": {
          "$ref": "#/$defs/semanticExpression"
        }
      }
    },
    "semanticAssertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/semanticAssertion"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "description",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "domain",
          "contract",
          "expected_result"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "allOf": [
              {
                "$ref": "task-contract.schema.json"
              },
              {
                "type": "object",
                "required": [
                  "inputs"
                ],
                "properties": {
                  "inputs": {
                    "type": "object",
                    "required": [
                      "result_spec"
                    ],
                    "properties": {
                      "result_spec": {
                        "$ref": "#/$defs/resultSpec"
                      },
                      "semantic_assertions": {
                        "$ref": "#/$defs/semanticAssertions"
                      }
                    }
                  }
                }
              }
            ]
          },
          "expected_result": true
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "domain": {
                  "const": "policy_decision"
                }
              }
            },
            "then": {
              "properties": {
                "contract": {
                  "properties": {
                    "inputs": {
                      "required": [
                        "policy",
                        "hypothetical_request"
                      ],
                      "properties": {
                        "policy": {
                          "type": "object"
                        },
                        "hypothetical_request": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
