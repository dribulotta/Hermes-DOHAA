{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dribulotta/Hermes-DOHAA/schemas/evaluation-suite.schema.json",
  "title": "Hermes-DOHAA comparative evaluation suite",
  "type": "object",
  "$defs": {
    "resultSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_keys",
        "additional_keys",
        "types",
        "enums"
      ],
      "properties": {
        "required_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "additional_keys": {
          "type": "boolean"
        },
        "types": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "array",
              "boolean",
              "integer",
              "null",
              "number",
              "object",
              "string"
            ]
          }
        },
        "enums": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "description",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "domain",
          "contract",
          "expected_result"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "allOf": [
              {
                "$ref": "task-contract.schema.json"
              },
              {
                "type": "object",
                "required": [
                  "inputs"
                ],
                "properties": {
                  "inputs": {
                    "type": "object",
                    "required": [
                      "result_spec"
                    ],
                    "properties": {
                      "result_spec": {
                        "$ref": "#/$defs/resultSpec"
                      }
                    }
                  }
                }
              }
            ]
          },
          "expected_result": true
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "domain": {
                  "const": "policy_decision"
                }
              }
            },
            "then": {
              "properties": {
                "contract": {
                  "properties": {
                    "inputs": {
                      "required": [
                        "policy",
                        "hypothetical_request"
                      ],
                      "properties": {
                        "policy": {
                          "type": "object"
                        },
                        "hypothetical_request": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
