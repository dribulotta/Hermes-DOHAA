{
  "schema_version": "1.0",
  "contract_id": "derived-source-selection",
  "objective": "Choose the greatest revision whose supplied primary and signature_valid flags are true. For ties choose the first such record in input order. These flags are data, not cryptographic verification. Return no claims, evidence or actions.",
  "inputs": {
    "policy": {
      "primary": true,
      "signature_valid": true
    },
    "records": [
      {
        "revision": 6,
        "stock": 40,
        "primary": true,
        "signature_valid": true
      },
      {
        "revision": 9,
        "stock": 900,
        "primary": false,
        "signature_valid": true
      },
      {
        "revision": 8,
        "stock": 45,
        "primary": true,
        "signature_valid": false
      },
      {
        "revision": 7,
        "stock": 37,
        "primary": true,
        "signature_valid": true
      }
    ],
    "result_spec": {
      "required_keys": [
        "revision",
        "stock"
      ],
      "additional_keys": false,
      "types": {
        "revision": "integer",
        "stock": "integer"
      }
    },
    "semantic_assertions": [
      {
        "assertion_id": "source-selection.revision",
        "operator": "equals",
        "left": {
          "op": "ref",
          "source": "result",
          "pointer": "/revision"
        },
        "right": {
          "op": "at",
          "args": [
            {
              "op": "project",
              "args": [
                {
                  "op": "sort_by",
                  "args": [
                    {
                      "op": "filter",
                      "args": [
                        {
                          "op": "filter",
                          "args": [
                            {
                              "op": "ref",
                              "source": "inputs",
                              "pointer": "/records"
                            },
                            {
                              "op": "ref",
                              "source": "inputs",
                              "pointer": "/policy/primary"
                            }
                          ],
                          "pointer": "/primary",
                          "comparator": "equals"
                        },
                        {
                          "op": "ref",
                          "source": "inputs",
                          "pointer": "/policy/signature_valid"
                        }
                      ],
                      "pointer": "/signature_valid",
                      "comparator": "equals"
                    }
                  ],
                  "pointer": "/revision",
                  "order": "descending"
                }
              ],
              "pointer": "/revision"
            }
          ],
          "index": 0
        }
      },
      {
        "assertion_id": "source-selection.stock",
        "operator": "equals",
        "left": {
          "op": "ref",
          "source": "result",
          "pointer": "/stock"
        },
        "right": {
          "op": "at",
          "args": [
            {
              "op": "project",
              "args": [
                {
                  "op": "sort_by",
                  "args": [
                    {
                      "op": "filter",
                      "args": [
                        {
                          "op": "filter",
                          "args": [
                            {
                              "op": "ref",
                              "source": "inputs",
                              "pointer": "/records"
                            },
                            {
                              "op": "ref",
                              "source": "inputs",
                              "pointer": "/policy/primary"
                            }
                          ],
                          "pointer": "/primary",
                          "comparator": "equals"
                        },
                        {
                          "op": "ref",
                          "source": "inputs",
                          "pointer": "/policy/signature_valid"
                        }
                      ],
                      "pointer": "/signature_valid",
                      "comparator": "equals"
                    }
                  ],
                  "pointer": "/revision",
                  "order": "descending"
                }
              ],
              "pointer": "/stock"
            }
          ],
          "index": 0
        }
      }
    ]
  },
  "acceptance_criteria": [
    {
      "criterion_id": "derived-values",
      "description": "Every result field must satisfy its visible input-derived formula.",
      "required_evidence": []
    }
  ],
  "allowed_actions": [],
  "forbidden_actions": [
    "shell.execute",
    "external.publish"
  ],
  "risk_level": "low",
  "max_attempts": 2,
  "requires_human_approval": false
}
